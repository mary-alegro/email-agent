# Copy to .env and fill in. .env is git-ignored.

# LLM provider: anthropic (default) or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5     # default for anthropic
# LLM_EFFORT=medium             # anthropic effort: low | medium | high | xhigh | max

# For OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=<an OpenAI model with structured-output support>
# LLM_EFFORT=                   # reasoning_effort, reasoning models only

# DATABASE_URL=sqlite:///data/app.db
# ERP_MCP_URL=http://localhost:8000/mcp   # unset = in-process mock ERP

# LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text      # text | json
